{
  "expo": {
    "name": "Zona",
    "slug": "zona",
    "version": "1.0.0",
    "orientation": "portrait",
    "android": {
      "package": "uz.zona.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBRUe-leQlt3k9ns-ZdQpiuQqchhliDkxs"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070B10"
      },
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Zona yurgan yo'lingizni chizish va hudud egallash uchun joylashuvdan foydalanadi.",
          "locationWhenInUsePermission": "Zona yurgan yo'lingizni chizish uchun joylashuvdan foydalanadi.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zona zonangizga rasm qo'yish uchun galereyaga ruxsat so'raydi."
        }
      ],
      "expo-audio",
      "@maplibre/maplibre-react-native",
      "expo-asset",
      "expo-notifications",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "50e5967b-2900-4e82-a91d-a8b389cf520c"
      },
      "googleWebClientId": "762976238717-bon39bggv1lf3otfjqpfie8f7ud9c379.apps.googleusercontent.com"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070B10"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "userInterfaceStyle": "light"
  }
}